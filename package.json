{
  "name": "flabs-tech",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:chrome": "npx playwright test --project=chromium",
    "test:e2e:ci": "npx playwright test --project=chromium --grep-invert \"visual snapshots\"",
    "test:e2e:update-snapshots": "npx playwright test --update-snapshots --project=chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "analyze": "cross-env ANALYZE=true next build",
    "lhci": "lhci autorun",
    "format": "prettier --write ."
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@ai-sdk/react": "^4.0.16",
    "@mantine/carousel": "^9.4.1",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/notifications": "^9.4.1",
    "@mdx-js/loader": "^3.1.0",
    "@next/mdx": "^16.0.10",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@tabler/icons-react": "^3.44.0",
    "@upstash/redis": "^1.38.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.15",
    "classnames": "^2.5.1",
    "cookie": "^1.0.2",
    "gray-matter": "^4.0.3",
    "next": "^16.0.10",
    "next-mdx-remote": "^6.0.0",
    "pino": "^10.3.1",
    "posthog-js": "^1.398.0",
    "posthog-node": "^5.21.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-gfm": "^4.0.1",
    "sass": "^1.86.3",
    "transliteration": "^2.3.5",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/eslintrc": "^3.3.5",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.61.0",
    "@storybook/addon-a11y": "^10.4.5",
    "@storybook/addon-docs": "^10.4.5",
    "@storybook/nextjs": "^10.4.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie": "^0.6.0",
    "@types/node": "^20.17.30",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "agenthood": "^3.9.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.4.5",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.16",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.4",
    "storybook": "^10.4.5",
    "typescript": "^5.8.3",
    "tzdata": "^1.0.44",
    "vitest": "^4.1.8"
  }
}
