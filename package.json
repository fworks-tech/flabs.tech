{
  "name": "flabs-tech",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "export": "next export",
    "build": "next build",
    "biome-write": "npx @biomejs/biome format --write .",
    "start": "next start",
    "lint": "npx @biomejs/biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:chrome": "npx playwright test --project=chromium",
    "test:e2e:ci": "npx playwright test --project=chromium --grep-invert \"visual snapshots\"",
    "test:e2e:update-snapshots": "npx playwright test --update-snapshots --project=chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "analyze": "cross-env ANALYZE=true next build",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@next/mdx": "^16.0.10",
    "@once-ui-system/core": "latest",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "classnames": "^2.5.1",
    "cookie": "^1.0.2",
    "gray-matter": "^4.0.3",
    "lint-staged": "^16.1.5",
    "next": "^16.0.10",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "sass": "^1.86.3",
    "transliteration": "^2.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^1.9.4",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.61.0",
    "@storybook/addon-a11y": "^10.4.5",
    "@storybook/addon-docs": "^10.4.5",
    "@storybook/nextjs": "^10.4.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie": "^0.6.0",
    "@types/node": "^20.17.30",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-storybook": "^10.4.5",
    "jsdom": "^29.1.1",
    "storybook": "^10.4.5",
    "typescript": "^5.8.3",
    "tzdata": "^1.0.44",
    "vitest": "^4.1.8"
  }
