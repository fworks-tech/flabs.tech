# Password for protected pages/routes (e.g., work-in-progress sections)
PAGE_ACCESS_PASSWORD=your-secure-password-here

# GitHub SSO for the hidden admin area (/admin)
# Create an OAuth App at https://github.com/settings/developers
#   Authorization callback URL: https://flabs.tech/api/auth/callback/github
#   (use http://localhost:3000/api/auth/callback/github for local dev)
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# GitHub username allowed to sign in (site owner only)
ALLOWED_GITHUB_LOGIN=
# Trust the hosting provider's forwarded headers (required on Vercel)
AUTH_TRUST_HOST=true

# Vercel sets NODE_ENV automatically:
# - development (local / `npm run dev`)
# - production  (`npm run build` + deployed)

# Logging level (server-side, overrides NODE_ENV default)
#   trace | debug | info | warn | error | fatal
#   Server default: info (production), debug (development)
LOG_LEVEL=debug

# Logging level (client/browser, bundled at build time)
#   trace | debug | info | warn | error | fatal
#   Browser default: warn
NEXT_PUBLIC_LOG_LEVEL=warn

# OpenCode Zen API key for the AI assistant
# Get yours at https://opencode.ai/auth
OPENCODE_API_KEY=

# Abuse prevention — state persistence (Upstash Redis)
# Get yours at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Abuse prevention — server-side PostHog events (posthog-node)
# Same project as NEXT_PUBLIC_POSTHOG_KEY below
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Abuse prevention — alert webhooks (optional; skipped when unset)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Abuse prevention — behavior
#   shadow: observe scores and notify without blocking (safe default)
#   enforce: actually quarantine/block detected abusers
ABUSE_RESPONSE_MODE=shadow
#   false: pseudonymize tracking keys with a keyed HMAC (GDPR/LGPD-friendly)
ABUSE_TRACK_IP=true
# HMAC key for anonymized tracking keys when ABUSE_TRACK_IP=false.
# Long random value; changes rotate the pseudonymous identity space.
ABUSE_KEY_SECRET=change-me-to-a-long-random-secret
# Retention window for signals/investigation cases (ms), default 1h
ABUSE_RETENTION_MS=3600000

# PostHog analytics (Cloud Free)
# Get your key at https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Dev.to API key for cross-posting articles
# Get yours at https://dev.to/settings/account
# Falls back to OPENCODE_API_KEY if not set
DEVTO_API_KEY=

# Medium integration token for cross-posting articles
# Get yours at https://medium.com/me/settings/security
MEDIUM_TOKEN=

# HashNode Personal Access Token for cross-posting articles
# Get yours at https://hashnode.com/settings/developer
# Note: HashNode GraphQL API now requires a Pro plan (paid) as of May 2026
HASHNODE_TOKEN=
HASHNODE_PUBLICATION_ID=
